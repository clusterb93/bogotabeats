# BogotaBeats — configuration Apache pour l'hébergement IONOS
# (copié à la racine du site par scripts/build.mjs ; ignoré par GitHub Pages)

Options -Indexes
DirectoryIndex index.html

# --- HTTPS obligatoire + adresse unique https://bogotabeats.com (sans www) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://bogotabeats.com%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/calendar
</IfModule>

# --- Cache : le contenu (HTML, JSON) est toujours revalidé pour que les mises à jour apparaissent tout de suite ;
#     CSS/JS gardés 1 h (ils ne changent qu'au déploiement) ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # --- En-têtes de sécurité ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType text/calendar .ics
  AddType image/svg+xml .svg
</IfModule>

# --- Ne jamais servir les fichiers cachés (.git, .env…) sauf .well-known (certificats) ---
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>
